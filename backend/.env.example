# ===== 数据库 =====
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/itea_agent?charset=utf8mb4

# ===== JWT =====
SECRET_KEY=change-this-to-a-random-secret-key
# 访问令牌短期有效(分钟),前端用刷新令牌在过期前后静默续期
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 刷新令牌有效期(分钟),默认 7 天
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# 公开注册允许的邮箱域(逗号分隔,留空不限制),例如 edu.cn,university.edu
REGISTER_EMAIL_DOMAINS=

# ===== LLM 底座(DeepSeek,兼容 OpenAI 接口格式)=====
# 官方文档: https://api-docs.deepseek.com/
# 统一使用 deepseek-flash(快速、低成本,覆盖全部场景)
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.3

# ===== 视觉模型(识图,可选)=====
# 留空则关闭图片识图;填写 OpenAI 兼容多模态接口即可启用
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=

# ===== 语音识别(可选)=====
# 留空则关闭录音转写;填写 OpenAI 兼容 transcription 接口即可启用
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=
ASR_TIMEOUT=60
ASR_MAX_BYTES=10485760
# 聊天侧文档解析上限(字节),解析后不落盘
CHAT_DOC_MAX_BYTES=10485760

# ===== 向量模型(本地 sentence-transformers)=====
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== 上下文工程(P1-2)=====
# 关闭后回退为全量注入,仅用于对比与排障
CONTEXT_BUDGET_ENABLED=true
CONTEXT_RAG_CHARS=2400
CONTEXT_MAX_FRAGMENTS=4
CONTEXT_PROFILE_CHARS=900
CONTEXT_SYLLABUS_CHARS=1200
CONTEXT_HISTORY_TOKENS=900

# ===== 项目自检(管理员)=====
# 留空则使用仓库根目录;只允许访问该目录内的只读内容
PROJECT_ROOT=
PROJECT_MAX_FILE_BYTES=524288
PROJECT_MAX_READ_LINES=400
PROJECT_TEST_TIMEOUT=300

# ===== 受控联网(教师/管理员)=====
# provider 可选 none/bing/serpapi,留空或 none 表示不启用联网检索
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_BASE=
WEB_SEARCH_API_KEY=
# 抓取白名单,逗号分隔,匹配子域名
WEB_ALLOWED_DOMAINS=moe.gov.cn,edu.cn,gov.cn
WEB_FETCH_TIMEOUT=10
WEB_FETCH_MAX_BYTES=2097152
WEB_CACHE_TTL=600

# ===== 应用 =====
# development/test 可使用本地默认值；production 必须显式替换 DATABASE_URL 与 SECRET_KEY，空值或默认值会阻止启动
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
STATIC_DIR=static
UPLOAD_DIR=uploads

# ============================================================
# 密钥安全说明:
# 1. 本文件仅作模板,请复制为 .env 并填入真实密钥
# 2. .env 已被 .gitignore 忽略,切勿提交到版本库
# 3. 生产环境建议使用环境变量或密钥管理服务注入,而非文件
# 4. 切勿在前端代码、日志、错误信息中输出 API 密钥
# ============================================================