# ===== 数据库 =====
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/itea_agent?charset=utf8mb4

# ===== JWT =====
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== LLM 底座(DeepSeek,兼容 OpenAI 接口格式)=====
# 官方文档: https://api-docs.deepseek.com/
# 统一使用 deepseek-flash(快速、低成本,覆盖全部场景)
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.3

# ===== 向量模型(本地 sentence-transformers)=====
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== 应用 =====
APP_HOST=0.0.0.0
APP_PORT=8000
STATIC_DIR=static
UPLOAD_DIR=uploads

# ============================================================
# 密钥安全说明:
# 1. 本文件仅作模板,请复制为 .env 并填入真实密钥
# 2. .env 已被 .gitignore 忽略,切勿提交到版本库
# 3. 生产环境建议使用环境变量或密钥管理服务注入,而非文件
# 4. 切勿在前端代码、日志、错误信息中输出 API 密钥
# ============================================================